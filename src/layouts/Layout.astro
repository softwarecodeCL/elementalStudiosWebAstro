---
import "aos/dist/aos.css";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/elementalStudios.png" />
    <meta name="generator" content={Astro.generator} />
    <title>Elemental Studios</title>
  </head>

  <body>
    <slot />
  </body>
</html>

<script>
  import "bootstrap/dist/js/bootstrap.bundle.min.js";
  import AOS from "aos";

  window.addEventListener("load", () => {
    AOS.init({
      duration: 1100,
      delay: 0,
      once: true,
      offset: 80,
      mirror: false,
      easing: "cubic-bezier(0.22, 1, 0.36, 1)",
      anchorPlacement: "top-bottom"
    });
  });
</script>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }

  body {
    overflow-x: hidden;
  }

  img {
    max-width: 100%;
    height: auto;
  }
</style>