---
const navItems = [
  { label: "Login Moodle", href: "https://moodle.elementalstudios.cl/login/index.php" }
];
---

<nav class="navbar-agency" id="mainNavbar">
  <div class="container navbar-shell">
    <a class="navbar-brand-agency" href="/" aria-label="Elemental Studios">
      <img src="/logorender.png" alt="Elemental Studios" class="logo" />
    </a>

    <ul class="nav-list-agency">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            target="_blank"
            rel="noopener noreferrer"
            class="login-btn"
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<div class="navbar-spacer"></div>

<script is:inline>
  const navbar = document.getElementById('mainNavbar');

  function toggleNavbarScroll() {
    if (!navbar) return;
    if (window.scrollY > 10) {
      navbar.classList.add('is-scrolled');
    } else {
      navbar.classList.remove('is-scrolled');
    }
  }

  toggleNavbarScroll();
  window.addEventListener('scroll', toggleNavbarScroll, { passive: true });
</script>
<style>
  :root {
    --nav-bg: rgba(255, 255, 255, 0.92);
    --nav-bg-scrolled: rgba(255, 255, 255, 0.98);
    --nav-border: rgba(15, 23, 42, 0.07);
    --nav-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
    --nav-shadow-scrolled: 0 18px 40px rgba(15, 23, 42, 0.12);

    --brand-primary: #28659e;
    --brand-primary-2: #347cc0;
    --brand-primary-dark: #1f5180;

    --text-dark: #0f172a;
    --text-muted: #475569;
    --white: #ffffff;

    --radius-pill: 999px;
    --radius-soft: 24px;

    --transition-smooth: 0.28s cubic-bezier(0.22, 1, 0.36, 1);
    --transition-fast: 0.22s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .navbar-agency {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 9999;
    background: var(--nav-bg);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--nav-border);
    box-shadow: var(--nav-shadow);
    transition:
      background var(--transition-smooth),
      box-shadow var(--transition-smooth),
      border-color var(--transition-smooth),
      backdrop-filter var(--transition-smooth);
  }

  .navbar-agency.is-scrolled {
    background: var(--nav-bg-scrolled);
    box-shadow: var(--nav-shadow-scrolled);
    border-bottom-color: rgba(15, 23, 42, 0.08);
  }

  .navbar-shell {
    width: min(1200px, calc(100% - 2rem));
    margin: 0 auto;
    min-height: 78px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .navbar-brand-agency {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }

  .logo {
    display: block;
    max-height: 95px;
    width: auto;
    transition:
      transform var(--transition-fast),
      filter var(--transition-fast),
      opacity var(--transition-fast);
  }

  .navbar-brand-agency:hover .logo {
    transform: translateY(-1px) scale(1.02);
    filter: saturate(1.04);
    opacity: 0.98;
  }

  .nav-list-agency {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin: 0;
    padding: 0;
  }

  .nav-list-agency li {
    margin: 0;
    padding: 0;
  }

  .login-btn,
  .login-btn:link,
  .login-btn:visited {
    position: relative;
    overflow: hidden;
    isolation: isolate;

    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 0.55rem;

    min-height: 46px;
    padding: 0.78rem 1.28rem;

    border-radius: var(--radius-pill);
    text-decoration: none !important;
    white-space: nowrap;

    font-size: 0.92rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.01em;
    color: var(--white) !important;

    background: linear-gradient(135deg, var(--brand-primary) 0%, var(--brand-primary-2) 100%) !important;
    border: 1px solid rgba(255, 255, 255, 0.18);

    box-shadow:
      0 10px 24px rgba(40, 101, 158, 0.24),
      0 2px 8px rgba(40, 101, 158, 0.12),
      inset 0 1px 0 rgba(255, 255, 255, 0.22);

    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast),
      background var(--transition-fast),
      filter var(--transition-fast),
      border-color var(--transition-fast);
  }

  .login-btn::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      120deg,
      rgba(255, 255, 255, 0) 0%,
      rgba(255, 255, 255, 0.18) 30%,
      rgba(255, 255, 255, 0) 60%
    );
    transform: translateX(-140%);
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .login-btn::after {
    content: "→";
    font-size: 0.94rem;
    line-height: 1;
    transition: transform var(--transition-fast);
  }

  .login-btn:hover,
  .login-btn:focus,
  .login-btn:active {
    color: var(--white) !important;
    text-decoration: none !important;
  }

  .login-btn:hover {
    transform: translateY(-2px);
    background: linear-gradient(135deg, #2d72b3 0%, var(--brand-primary-dark) 100%) !important;
    box-shadow:
      0 16px 32px rgba(40, 101, 158, 0.30),
      0 6px 16px rgba(40, 101, 158, 0.14),
      inset 0 1px 0 rgba(255, 255, 255, 0.22);
    filter: saturate(1.04);
  }

  .login-btn:hover::before {
    transform: translateX(140%);
  }

  .login-btn:hover::after {
    transform: translateX(4px);
  }

  .login-btn:focus-visible {
    outline: none;
    box-shadow:
      0 0 0 4px rgba(40, 101, 158, 0.18),
      0 16px 32px rgba(40, 101, 158, 0.28),
      inset 0 1px 0 rgba(255, 255, 255, 0.22);
  }

  .login-btn:active {
    transform: translateY(0);
    box-shadow:
      0 8px 18px rgba(40, 101, 158, 0.22),
      0 2px 8px rgba(40, 101, 158, 0.12),
      inset 0 1px 0 rgba(255, 255, 255, 0.18);
  }

  .navbar-spacer {
    height: 92px;
  }

  @media (max-width: 991.98px) {
    .navbar-shell {
      width: min(1200px, calc(100% - 1.25rem));
      min-height: 74px;
    }

    .logo {
      max-height: 82px;
    }

    .login-btn,
    .login-btn:link,
    .login-btn:visited {
      min-height: 43px;
      padding: 0.72rem 1.05rem;
      font-size: 0.88rem;
    }

    .navbar-spacer {
      height: 86px;
    }
  }

  @media (max-width: 575.98px) {
    .navbar-shell {
      width: min(1200px, calc(100% - 1rem));
      min-height: 70px;
      gap: 0.75rem;
    }

    .logo {
      max-height: 80px;
    }

    .nav-list-agency {
      gap: 0.55rem;
    }

    .login-btn,
    .login-btn:link,
    .login-btn:visited {
      min-height: 40px;
      padding: 0.7rem 0.95rem;
      font-size: 0.84rem;
      gap: 0.42rem;
      box-shadow:
        0 8px 18px rgba(40, 101, 158, 0.22),
        0 2px 8px rgba(40, 101, 158, 0.10),
        inset 0 1px 0 rgba(255, 255, 255, 0.18);
    }

    .login-btn::after {
      font-size: 0.88rem;
    }

    .navbar-spacer {
      height: 80px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .navbar-agency,
    .logo,
    .login-btn,
    .login-btn::before,
    .login-btn::after {
      transition: none !important;
      animation: none !important;
    }
  }
</style>