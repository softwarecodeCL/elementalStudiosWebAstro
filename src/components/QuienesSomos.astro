---
const items = [
  {
    logo: '/logo-empresa-1.png',
    image: '/elementalStudios.png',
    title: 'Capacitación con enfoque práctico',
    text: 'Diseñamos programas de idiomas aplicados a contextos reales de trabajo, enfocados en mejorar la atención, la comunicación y la experiencia del cliente en hotelería, turismo y empresas.'
  },
  {
    logo: '/logo-empresa-2.png',
    image: '/sence.png',
    title: 'Organismo de capacitación con Código SENCE',
    text: 'Somos un organismo de capacitación reconocido que cuenta con Código SENCE, lo que permite a las empresas acceder a programas de formación con beneficios tributarios. Nuestros cursos están diseñados para fortalecer las habilidades de comunicación en inglés y portugués dentro de contextos reales de trabajo, especialmente en hotelería, turismo y atención al cliente.'
  }
];
---

<section class="quienes-somos" aria-label="Quiénes somos">
  <div class="container">
    <div
      class="section-heading"
      data-aos="zoom-out-up"
      data-aos-duration="1200"
      data-aos-easing="cubic-bezier(0.22, 1, 0.36, 1)"
    >
      <span
        class="eyebrow"
        data-aos="fade-down"
        data-aos-delay="80"
        data-aos-duration="900"
      >
        Quiénes somos
      </span>

      <h2
        data-aos="fade-up"
        data-aos-delay="140"
        data-aos-duration="1100"
      >
        Formación en idiomas orientada a resultados reales
      </h2>

      <p
        data-aos="fade-up"
        data-aos-delay="240"
        data-aos-duration="1200"
      >
        Combinamos metodología, experiencia y foco operativo para entregar programas
        que generan impacto en la atención, el servicio y la comunicación profesional.
      </p>
    </div>

    <div class="qs-grid">
      {items.map((item, index) => (
        <article
          class="qs-card"
          data-aos={index % 2 === 0 ? "fade-right" : "fade-left"}
          data-aos-delay={index * 180}
          data-aos-duration="1200"
          data-aos-easing="cubic-bezier(0.22, 1, 0.36, 1)"
        >
          <div
            class="qs-image-wrap"
            data-aos="zoom-in-up"
            data-aos-delay={120 + index * 180}
            data-aos-duration="1300"
          >
            <img
              src={item.image}
              alt={item.title}
              class="qs-image"
              loading="lazy"
              decoding="async"
              width="640"
              height="400"
            />
          </div>

          <div
            class="qs-content"
            data-aos="fade-up"
            data-aos-delay={220 + index * 180}
            data-aos-duration="1100"
          >
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .quienes-somos {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at top left, rgba(207,151,82,0.08), transparent 26%),
      linear-gradient(180deg, #f8fafc 0%, #eef3f8 100%);
    padding: clamp(4rem, 8vw, 7rem) 0;
  }

  .quienes-somos::before {
    content: "";
    position: absolute;
    inset: auto -10% 8% auto;
    width: 340px;
    height: 340px;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(40,101,158,0.10), transparent 70%);
    pointer-events: none;
    filter: blur(18px);
  }

  .container {
    position: relative;
    z-index: 1;
    width: min(1200px, calc(100% - 2rem));
    margin: 0 auto;
  }

  .section-heading {
    max-width: 820px;
    margin: 0 auto 3rem;
    text-align: center;
  }

  .eyebrow {
    display: inline-block;
    margin-bottom: 0.85rem;
    padding: 0.55rem 0.95rem;
    border-radius: 999px;
    background: rgba(8, 17, 29, 0.06);
    color: #9a6a2f;
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: 0.03em;
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.06);
  }

  .section-heading h2 {
    margin: 0 0 1rem;
    color: #0f172a;
    font-size: clamp(2rem, 4.5vw, 3.3rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .section-heading p {
    margin: 0;
    color: #475569;
    font-size: clamp(1rem, 1.5vw, 1.1rem);
    line-height: 1.75;
  }

  .qs-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    align-items: stretch;
  }

  .qs-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 24px;
    background:
      linear-gradient(180deg, rgba(255,255,255,0.98) 0%, rgba(255,255,255,0.94) 100%);
    box-shadow:
      0 10px 24px rgba(15, 23, 42, 0.08),
      0 1px 0 rgba(255,255,255,0.8) inset;
    transition:
      transform 0.35s ease,
      box-shadow 0.35s ease,
      border-color 0.35s ease;
    will-change: transform;
  }

  .qs-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(255,255,255,0.22) 0%,
      rgba(255,255,255,0.04) 45%,
      rgba(40,101,158,0.04) 100%
    );
    pointer-events: none;
  }

  .qs-card:hover {
    transform: translateY(-8px);
    box-shadow:
      0 24px 44px rgba(15, 23, 42, 0.12),
      0 1px 0 rgba(255,255,255,0.88) inset;
    border-color: rgba(207,151,82,0.26);
  }

  .qs-image-wrap {
    padding: 1rem 1rem 0;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 220px;
  }

  .qs-image {
    display: block;
    margin: 0 auto;
    max-width: 100%;
    max-height: 220px;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 18px;
    transform: translateZ(0);
    transition: transform 0.45s ease, filter 0.45s ease;
  }

  .qs-card:hover .qs-image {
    transform: scale(1.03);
    filter: saturate(1.02);
  }

  .qs-content {
    padding: 1.25rem 1.25rem 1.4rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .qs-content h3 {
    margin: 0 0 0.85rem;
    color: #0f172a;
    font-size: clamp(1.2rem, 2vw, 1.55rem);
    line-height: 1.2;
    min-height: 3rem;
  }

  .qs-content p {
    margin: 0;
    color: #475569;
    font-size: 1rem;
    line-height: 1.7;
  }

  @media (max-width: 991.98px) {
    .qs-grid {
      grid-template-columns: 1fr;
    }

    .section-heading {
      margin-bottom: 2rem;
    }

    .qs-card {
      transition: box-shadow 0.3s ease, border-color 0.3s ease;
    }

    .qs-card:hover {
      transform: none;
      box-shadow:
        0 14px 26px rgba(15, 23, 42, 0.09),
        0 1px 0 rgba(255,255,255,0.88) inset;
    }

    .qs-card:hover .qs-image {
      transform: none;
      filter: none;
    }
  }

  @media (max-width: 575.98px) {
    .quienes-somos {
      padding: 3.4rem 0;
    }

    .container {
      width: min(100% - 1rem, 1200px);
    }

    .qs-card {
      border-radius: 20px;
      box-shadow: 0 8px 18px rgba(15, 23, 42, 0.07);
    }

    .qs-image-wrap {
      min-height: 180px;
      padding: 0.9rem 0.9rem 0;
    }

    .qs-image {
      max-height: 180px;
      border-radius: 16px;
    }

    .qs-content {
      padding: 1rem 0.95rem 1.15rem;
    }

    .qs-content h3 {
      min-height: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .qs-card,
    .qs-image,
    .navbar,
    .section-heading,
    .eyebrow {
      transition: none !important;
      animation: none !important;
    }
  }
</style>